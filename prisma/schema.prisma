generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users ───────────────────────────────────────────────────────────────────

enum UserStatus {
  active
  suspended
  deleted
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  firstName    String?    @map("first_name")
  lastName     String?    @map("last_name")
  displayName    String?    @map("display_name")
  avatarData     Bytes?     @map("avatar_data")
  avatarMimeType String?    @map("avatar_mime_type")
  status         UserStatus @default(active)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  credentials             Credential[]
  passkeys                Passkey[]
  mfaMethods              MfaMethod[]
  sessions                Session[]
  devices                 Device[]
  organizationMemberships OrganizationMembership[]
  applicationAccess       ApplicationAccess[]
  auditEvents             AuditEvent[]             @relation("AuditActor")
  emailVerifications      EmailVerification[]
  passwordResets          PasswordReset[]
  refreshTokens           RefreshToken[]
  ssoSessions             SsoSession[]

  @@map("users")
}

// ─── Credentials ─────────────────────────────────────────────────────────────

enum CredentialType {
  password
  passkey
  google
  microsoft
  enterprise_sso
}

model Credential {
  id             String         @id @default(uuid())
  userId         String         @map("user_id")
  credentialType CredentialType @map("credential_type")
  passwordHash   String?        @map("password_hash")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  lastUsedAt     DateTime?      @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, credentialType])
  @@map("credentials")
}

// ─── Email Verification ───────────────────────────────────────────────────────

model EmailVerification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verifications")
}

// ─── Password Reset ───────────────────────────────────────────────────────────

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

// ─── Passkeys ────────────────────────────────────────────────────────────────

model Passkey {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  credentialId String    @unique @map("credential_id")
  publicKey    Bytes     @map("public_key")
  counter      BigInt    @default(0)
  deviceName   String?   @map("device_name")
  createdAt    DateTime  @default(now()) @map("created_at")
  lastUsedAt   DateTime? @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("passkeys")
}

// ─── MFA ──────────────────────────────────────────────────────────────────────

enum MfaType {
  totp
  webauthn
  recovery_code
}

enum MfaStatus {
  pending
  active
  disabled
}

model MfaMethod {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  type            MfaType
  status          MfaStatus @default(pending)
  secretReference String?   @map("secret_reference")
  createdAt       DateTime  @default(now()) @map("created_at")
  verifiedAt      DateTime? @map("verified_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  recoveryCodes RecoveryCode[]

  @@map("mfa_methods")
}

model RecoveryCode {
  id          String    @id @default(uuid())
  mfaMethodId String    @map("mfa_method_id")
  codeHash    String    @map("code_hash")
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  mfaMethod MfaMethod @relation(fields: [mfaMethodId], references: [id], onDelete: Cascade)

  @@map("recovery_codes")
}

// ─── Sessions ─────────────────────────────────────────────────────────────────

enum SessionRiskStatus {
  normal
  elevated
  suspicious
  revoked
}

model Session {
  id             String            @id @default(uuid())
  userId         String            @map("user_id")
  deviceId       String?           @map("device_id")
  createdAt      DateTime          @default(now()) @map("created_at")
  lastActivityAt DateTime          @default(now()) @map("last_activity_at")
  expiresAt      DateTime          @map("expires_at")
  revokedAt      DateTime?         @map("revoked_at")
  riskStatus     SessionRiskStatus @default(normal) @map("risk_status")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  device        Device?        @relation(fields: [deviceId], references: [id])
  refreshTokens RefreshToken[]

  @@map("sessions")
}

model RefreshToken {
  id        String    @id @default(uuid())
  sessionId String    @map("session_id")
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ─── Devices ──────────────────────────────────────────────────────────────────

enum DeviceTrustStatus {
  unknown
  trusted
  untrusted
}

model Device {
  id           String            @id @default(uuid())
  userId       String            @map("user_id")
  deviceName   String?           @map("device_name")
  userAgent    String?           @map("user_agent")
  firstSeenAt  DateTime          @default(now()) @map("first_seen_at")
  lastSeenAt   DateTime          @default(now()) @map("last_seen_at")
  trustedStatus DeviceTrustStatus @default(unknown) @map("trusted_status")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@map("devices")
}

// ─── Organizations ────────────────────────────────────────────────────────────

enum OrgStatus {
  active
  suspended
  deleted
}

model Organization {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  status    OrgStatus @default(active)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  memberships      OrganizationMembership[]
  securityPolicy   OrganizationSecurityPolicy?
  ssoConnections   EnterpriseSsoConnection[]
  applicationAccess ApplicationAccess[]
  auditEvents      AuditEvent[]

  @@map("organizations")
}

// ─── Organization Membership ──────────────────────────────────────────────────

enum MembershipStatus {
  invited
  active
  suspended
  removed
}

enum OrgRole {
  organization_owner
  identity_admin
  security_admin
  application_admin
  user_manager
  billing_admin
  member
}

model OrganizationMembership {
  id             String           @id @default(uuid())
  organizationId String           @map("organization_id")
  userId         String           @map("user_id")
  role           OrgRole          @default(member)
  status         MembershipStatus @default(invited)
  joinedAt       DateTime?        @map("joined_at")
  createdAt      DateTime         @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("organization_memberships")
}

// ─── Organization Invitations ─────────────────────────────────────────────────

model OrganizationInvitation {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  email          String
  role           OrgRole   @default(member)
  tokenHash      String    @unique @map("token_hash")
  expiresAt      DateTime  @map("expires_at")
  acceptedAt     DateTime? @map("accepted_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("organization_invitations")
}

// ─── Organization Security Policies ──────────────────────────────────────────

model OrganizationSecurityPolicy {
  organizationId       String   @id @map("organization_id")
  requireMfa           Boolean  @default(false) @map("require_mfa")
  requireSso           Boolean  @default(false) @map("require_sso")
  allowedAuthMethods   String[] @map("allowed_auth_methods")
  sessionMaxAgeSecs    Int      @default(2592000) @map("session_max_age_secs")
  updatedAt            DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_security_policies")
}

// ─── Applications ─────────────────────────────────────────────────────────────

enum AppStatus {
  active
  inactive
}

enum ApplicationType {
  web
  spa
  mobile
  server
  service
  internal
}

model Application {
  id          String          @id @default(uuid())
  name        String
  slug        String          @unique
  type        ApplicationType @default(web)
  description String?
  logoUrl     String?         @map("logo_url")
  homepageUrl String?         @map("homepage_url")
  status      AppStatus       @default(active)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  oauthClients      OAuthClient[]
  applicationAccess ApplicationAccess[]
  authCodes         AuthorizationCode[]
  auditEvents       AuditEvent[]

  @@map("applications")
}

// ─── OAuth Clients ────────────────────────────────────────────────────────────

enum OAuthClientStatus {
  active
  revoked
}

model OAuthClient {
  id                  String           @id @default(uuid())
  applicationId       String           @map("application_id")
  clientId            String           @unique @map("client_id")
  clientSecretHash    String?          @map("client_secret_hash")
  redirectUris        String[]         @map("redirect_uris")
  allowedScopes       String[]         @map("allowed_scopes")
  status              OAuthClientStatus @default(active)
  createdAt           DateTime         @default(now()) @map("created_at")

  application   Application         @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  authCodes     AuthorizationCode[]

  @@map("oauth_clients")
}

// ─── Authorization Codes ──────────────────────────────────────────────────────

model AuthorizationCode {
  id            String    @id @default(uuid())
  clientId      String    @map("client_id")
  applicationId String    @map("application_id")
  userId        String    @map("user_id")
  codeHash      String    @unique @map("code_hash")
  redirectUri   String    @map("redirect_uri")
  scopes        String[]
  pkceChallenge String    @map("pkce_challenge")
  pkceMethod    String    @default("S256") @map("pkce_method")
  expiresAt     DateTime  @map("expires_at")
  usedAt        DateTime? @map("used_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  client      OAuthClient @relation(fields: [clientId], references: [clientId])
  application Application @relation(fields: [applicationId], references: [id])

  @@map("authorization_codes")
}

// ─── Application Access ───────────────────────────────────────────────────────

enum AccessStatus {
  active
  suspended
  revoked
}

model ApplicationAccess {
  id             String       @id @default(uuid())
  userId         String       @map("user_id")
  organizationId String       @map("organization_id")
  applicationId  String       @map("application_id")
  status         AccessStatus @default(active)
  createdAt      DateTime     @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  application  Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId, applicationId])
  @@map("application_access")
}

// ─── Enterprise SSO ───────────────────────────────────────────────────────────

enum SsoProtocol {
  oidc
  saml
}

enum SsoStatus {
  active
  inactive
}

model EnterpriseSsoConnection {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  protocol       SsoProtocol
  issuer         String
  domains        String[]
  metadata       Json
  status         SsoStatus @default(inactive)
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("enterprise_sso_connections")
}

// ─── SSO Sessions ─────────────────────────────────────────────────────────────

model SsoSession {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime  @default(now()) @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@map("sso_sessions")
}

// ─── Audit Events ─────────────────────────────────────────────────────────────

model AuditEvent {
  id             String   @id @default(uuid())
  eventType      String   @map("event_type")
  actorUserId    String?  @map("actor_user_id")
  organizationId String?  @map("organization_id")
  applicationId  String?  @map("application_id")
  targetType     String?  @map("target_type")
  targetId       String?  @map("target_id")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  metadata       Json     @default("{}")
  occurredAt     DateTime @default(now()) @map("occurred_at")

  actorUser    User?         @relation("AuditActor", fields: [actorUserId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])
  application  Application?  @relation(fields: [applicationId], references: [id])

  @@index([actorUserId])
  @@index([organizationId])
  @@index([eventType])
  @@index([occurredAt])
  @@map("audit_events")
}

// ─── Login Attempts (rate limiting / lockout) ─────────────────────────────────

model LoginAttempt {
  id          String   @id @default(uuid())
  identifier  String
  ipAddress   String   @map("ip_address")
  success     Boolean
  occurredAt  DateTime @default(now()) @map("occurred_at")

  @@index([identifier, occurredAt])
  @@index([ipAddress, occurredAt])
  @@map("login_attempts")
}

// ═══════════════════════════════════════════════════════════════════════════════
// YESP HIREFLOW — Hiring Management Platform
// ═══════════════════════════════════════════════════════════════════════════════

// ─── HireFlow: Pipelines ──────────────────────────────────────────────────────

model HfPipeline {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  description    String?
  isTemplate     Boolean  @default(false) @map("is_template")
  isActive       Boolean  @default(true)  @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt      @map("updated_at")

  stages       HfPipelineStage[]
  jobs         HfJob[]
  applications HfApplication[]

  @@index([organizationId])
  @@map("hf_pipelines")
}

model HfPipelineStage {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  pipelineId     String   @map("pipeline_id")
  name           String
  stageKey       String   @map("stage_key")
  position       Int
  isTerminal     Boolean  @default(false) @map("is_terminal")
  terminalType   String?  @map("terminal_type")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt      @map("updated_at")

  pipeline         HfPipeline                  @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  applications     HfApplication[]             @relation("CurrentStage")
  stageHistoryFrom HfApplicationStageHistory[] @relation("FromStage")
  stageHistoryTo   HfApplicationStageHistory[] @relation("ToStage")

  @@unique([pipelineId, stageKey])
  @@unique([pipelineId, position])
  @@index([pipelineId])
  @@map("hf_pipeline_stages")
}

// ─── HireFlow: Jobs ───────────────────────────────────────────────────────────

model HfJob {
  id                  String    @id @default(uuid())
  organizationId      String    @map("organization_id")
  pipelineId          String?   @map("pipeline_id")
  title               String
  department          String?
  location            String?
  employmentType      String?   @map("employment_type")
  workMode            String?   @map("work_mode")
  hiringManagerUserId String?   @map("hiring_manager_user_id")
  recruiterUserId     String?   @map("recruiter_user_id")
  openPositions       Int       @default(1)     @map("open_positions")
  status              String    @default("draft")
  description         String?
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt      @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  pipeline     HfPipeline?      @relation(fields: [pipelineId], references: [id])
  applications HfApplication[]
  tasks        HfTask[]
  hiringTeam   HfJobHiringTeam[]
  rounds       HfInterviewRound[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("hf_jobs")
}

// ─── HireFlow: Candidates ─────────────────────────────────────────────────────

model HfCandidate {
  id                   String    @id @default(uuid())
  organizationId       String    @map("organization_id")
  firstName            String    @map("first_name")
  lastName             String?   @map("last_name")
  email                String?
  phone                String?
  headline             String?
  location             String?
  currentCompany       String?   @map("current_company")
  currentTitle         String?   @map("current_title")
  totalExperienceYears Decimal?  @map("total_experience_years")
  summary              String?
  source               String?
  linkedinUrl          String?   @map("linkedin_url")
  portfolioUrl         String?   @map("portfolio_url")
  notes                String?
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt      @map("updated_at")
  deletedAt            DateTime? @map("deleted_at")

  applications   HfApplication[]
  documents      HfCandidateDocument[]
  tagAssignments HfCandidateTagAssignment[]
  tasks          HfTask[]

  @@index([organizationId])
  @@index([organizationId, email])
  @@map("hf_candidates")
}

model HfCandidateDocument {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  candidateId    String   @map("candidate_id")
  documentType   String   @map("document_type")
  fileName       String   @map("file_name")
  storageKey     String   @map("storage_key")
  mimeType       String?  @map("mime_type")
  fileSize       BigInt?   @map("file_size")
  createdAt      DateTime  @default(now()) @map("created_at")
  deletedAt      DateTime? @map("deleted_at")

  candidate HfCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("hf_candidate_documents")
}

model HfCandidateTag {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  createdAt      DateTime @default(now()) @map("created_at")

  assignments HfCandidateTagAssignment[]

  @@unique([organizationId, name])
  @@map("hf_candidate_tags")
}

model HfCandidateTagAssignment {
  candidateId String @map("candidate_id")
  tagId       String @map("tag_id")

  candidate HfCandidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  tag       HfCandidateTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([candidateId, tagId])
  @@map("hf_candidate_tag_assignments")
}

// ─── HireFlow: Applications ───────────────────────────────────────────────────

model HfApplication {
  id              String    @id @default(uuid())
  organizationId  String    @map("organization_id")
  jobId           String    @map("job_id")
  candidateId     String    @map("candidate_id")
  pipelineId      String?   @map("pipeline_id")
  currentStageId  String?   @map("current_stage_id")
  status          String    @default("active")
  appliedAt       DateTime  @default(now()) @map("applied_at")
  coverNote       String?   @map("cover_note")
  source          String?
  rejectionReason String?   @map("rejection_reason")
  rejectedAt      DateTime? @map("rejected_at")
  hiredAt         DateTime? @map("hired_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt      @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  job          HfJob                       @relation(fields: [jobId], references: [id])
  candidate    HfCandidate                 @relation(fields: [candidateId], references: [id])
  pipeline     HfPipeline?                 @relation(fields: [pipelineId], references: [id])
  currentStage HfPipelineStage?            @relation("CurrentStage", fields: [currentStageId], references: [id])
  stageHistory   HfApplicationStageHistory[]
  activities     HfApplicationActivity[]
  interviews     HfInterview[]
  tasks          HfTask[]
  communications HfCommunication[]

  @@index([organizationId])
  @@index([jobId])
  @@index([candidateId])
  @@index([currentStageId])
  @@map("hf_applications")
}

model HfApplicationStageHistory {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  applicationId   String   @map("application_id")
  fromStageId     String?  @map("from_stage_id")
  toStageId       String   @map("to_stage_id")
  changedByUserId String?  @map("changed_by_user_id")
  reason          String?
  createdAt       DateTime @default(now()) @map("created_at")

  application HfApplication    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStage   HfPipelineStage? @relation("FromStage", fields: [fromStageId], references: [id])
  toStage     HfPipelineStage  @relation("ToStage",   fields: [toStageId],   references: [id])

  @@index([applicationId])
  @@map("hf_application_stage_history")
}

model HfApplicationActivity {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  applicationId  String   @map("application_id")
  activityType   String   @map("activity_type")
  actorUserId    String?  @map("actor_user_id")
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")

  application HfApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("hf_application_activities")
}

// ─── HireFlow: Interviews ─────────────────────────────────────────────────────

model HfInterview {
  id              String    @id @default(uuid())
  organizationId  String    @map("organization_id")
  applicationId   String    @map("application_id")
  roundId         String?   @map("round_id")
  scorecardId     String?   @map("scorecard_id")
  title           String
  roundNumber     Int?      @map("round_number")
  scheduledStart  DateTime? @map("scheduled_start")
  scheduledEnd    DateTime? @map("scheduled_end")
  timezone        String?
  meetingUrl      String?   @map("meeting_url")
  location        String?
  // status machine: requested | scheduled | confirmed | completed | feedback_pending | feedback_complete | cancelled
  status          String    @default("scheduled")
  cancelledAt     DateTime? @map("cancelled_at")
  cancelReason    String?   @map("cancel_reason")
  completedAt     DateTime? @map("completed_at")
  createdByUserId String?   @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt      @map("updated_at")

  application  HfApplication            @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  round        HfInterviewRound?        @relation("InterviewRound", fields: [roundId], references: [id])
  scorecard    HfScorecardTemplate?     @relation("ScorecardTemplate", fields: [scorecardId], references: [id])
  participants HfInterviewParticipant[]
  feedbacks    HfFeedback[]

  @@index([applicationId])
  @@index([organizationId, scheduledStart])
  @@map("hf_interviews")
}

model HfInterviewParticipant {
  id               String   @id @default(uuid())
  interviewId      String   @map("interview_id")
  userId           String   @map("user_id")
  participantType  String   @map("participant_type")
  feedbackRequired Boolean  @default(true) @map("feedback_required")
  createdAt        DateTime @default(now()) @map("created_at")

  interview HfInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@unique([interviewId, userId])
  @@map("hf_interview_participants")
}

// ─── HireFlow: Tasks ──────────────────────────────────────────────────────────

model HfTask {
  id               String    @id @default(uuid())
  organizationId   String    @map("organization_id")
  applicationId    String?   @map("application_id")
  candidateId      String?   @map("candidate_id")
  jobId            String?   @map("job_id")
  taskType         String    @map("task_type")
  title            String
  description      String?
  // status machine: pending | in_progress | completed | cancelled | snoozed
  status           String    @default("pending")
  priority         String    @default("normal") // low | normal | high | urgent
  assignedToUserId String?   @map("assigned_to_user_id")
  dueAt            DateTime? @map("due_at")
  slaBreachedAt    DateTime? @map("sla_breached_at")
  completedAt      DateTime? @map("completed_at")
  sourceEvent      String?   @map("source_event")
  deletedAt        DateTime? @map("deleted_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt      @map("updated_at")

  application HfApplication? @relation(fields: [applicationId], references: [id])
  candidate   HfCandidate?   @relation(fields: [candidateId], references: [id])
  job         HfJob?         @relation(fields: [jobId], references: [id])

  @@index([organizationId, status])
  @@index([assignedToUserId, status])
  @@index([organizationId, dueAt])
  @@map("hf_tasks")
}

// ─── HireFlow: Phase 2 — Role Permissions ─────────────────────────────────────

// HireFlow-specific role inside an org (separate from Yesp Auth org role)
model HfMember {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  role           String   @default("member") // admin | manager | recruiter | coordinator | interviewer | member
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt      @map("updated_at")

  jobAssignments HfJobHiringTeam[]

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@map("hf_members")
}

// Who is on a specific job's hiring team and in what capacity
model HfJobHiringTeam {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  jobId          String   @map("job_id")
  memberId       String   @map("member_id")
  teamRole       String   @map("team_role") // hiring_manager | recruiter | coordinator
  createdAt      DateTime @default(now()) @map("created_at")

  job    HfJob    @relation(fields: [jobId],    references: [id], onDelete: Cascade)
  member HfMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([jobId, memberId])
  @@index([organizationId, jobId])
  @@map("hf_job_hiring_team")
}

// ─── HireFlow: Phase 3 — Interview Engine (extended) ──────────────────────────

// Interview round template for a job (e.g. "Round 1 - Screening", "Round 2 - Technical")
model HfInterviewRound {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  jobId          String   @map("job_id")
  name           String
  roundNumber    Int      @map("round_number")
  durationMins   Int?     @map("duration_mins")
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")

  job        HfJob         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  interviews HfInterview[] @relation("InterviewRound")

  @@unique([jobId, roundNumber])
  @@index([organizationId, jobId])
  @@map("hf_interview_rounds")
}

// ─── HireFlow: Phase 4 — Scorecard Engine ─────────────────────────────────────

// Reusable scorecard template (can be linked to a job or used globally)
model HfScorecardTemplate {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  description    String?
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt      @map("updated_at")

  competencies HfScorecardCompetency[]
  interviews   HfInterview[]          @relation("ScorecardTemplate")
  feedbacks    HfFeedback[]

  @@index([organizationId])
  @@map("hf_scorecard_templates")
}

// Competency / dimension inside a scorecard template
model HfScorecardCompetency {
  id           String  @id @default(uuid())
  templateId   String  @map("template_id")
  name         String
  description  String?
  ratingMin    Int     @default(1) @map("rating_min")
  ratingMax    Int     @default(5) @map("rating_max")
  weight       Decimal @default(1) // relative weight for overall score
  isRequired   Boolean @default(true) @map("is_required")
  position     Int     @default(0)

  template HfScorecardTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  answers  HfFeedbackAnswer[]

  @@index([templateId])
  @@map("hf_scorecard_competencies")
}

// Interview feedback submitted by a participant
model HfFeedback {
  id              String    @id @default(uuid())
  organizationId  String    @map("organization_id")
  interviewId     String    @map("interview_id")
  participantId   String    @map("participant_id")   // HfInterviewParticipant.id
  scorecardId     String?   @map("scorecard_id")     // HfScorecardTemplate.id
  overallScore    Decimal?  @map("overall_score")
  recommendation  String?   // strong_hire | hire | no_hire | strong_no_hire
  strengths       String?
  concerns        String?
  privateNotes    String?   @map("private_notes")
  submittedAt     DateTime? @map("submitted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt      @map("updated_at")

  interview   HfInterview           @relation(fields: [interviewId],   references: [id], onDelete: Cascade)
  scorecard   HfScorecardTemplate?  @relation(fields: [scorecardId],  references: [id])
  answers     HfFeedbackAnswer[]

  @@unique([interviewId, participantId])
  @@index([organizationId, interviewId])
  @@map("hf_feedback")
}

// One answer per competency inside a feedback response
model HfFeedbackAnswer {
  id            String   @id @default(uuid())
  feedbackId    String   @map("feedback_id")
  competencyId  String   @map("competency_id")
  rating        Int?
  comment       String?
  createdAt     DateTime @default(now()) @map("created_at")

  feedback    HfFeedback            @relation(fields: [feedbackId],   references: [id], onDelete: Cascade)
  competency  HfScorecardCompetency @relation(fields: [competencyId], references: [id])

  @@unique([feedbackId, competencyId])
  @@index([feedbackId])
  @@map("hf_feedback_answers")
}

// ─── HireFlow: Phase 5 — SLA Engine ───────────────────────────────────────────

// SLA policy defines time limits for task types
model HfSlaPolicy {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  taskType        String   @map("task_type")   // matches HfTask.taskType
  priority        String   @default("normal")
  warningMins     Int      @map("warning_mins")
  dueMins         Int      @map("due_mins")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt      @map("updated_at")

  @@unique([organizationId, taskType, priority])
  @@index([organizationId])
  @@map("hf_sla_policies")
}

// SLA event log — immutable record of each SLA state change
model HfSlaEvent {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  eventType String   @map("event_type") // SLA_STARTED | SLA_WARNING | SLA_BREACHED | SLA_MET
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([taskId])
  @@map("hf_sla_events")
}

// ─── HireFlow: Phase 6 — Automation Rules ─────────────────────────────────────

model HfAutomationRule {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  description    String?
  trigger        String   // INTERVIEW_COMPLETED | STAGE_CHANGED | TASK_SLA_BREACHED | etc.
  conditions     Json     @default("[]")  // array of {field, op, value}
  actions        Json     @default("[]")  // array of {type, payload}
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt      @map("updated_at")

  executions HfAutomationExecution[]

  @@index([organizationId, trigger])
  @@map("hf_automation_rules")
}

// Execution log for each time a rule fires
model HfAutomationExecution {
  id        String   @id @default(uuid())
  ruleId    String   @map("rule_id")
  trigger   String
  payload   Json     @default("{}")
  result    String   @default("success") // success | failed | skipped
  error     String?
  createdAt DateTime @default(now()) @map("created_at")

  rule HfAutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@map("hf_automation_executions")
}

// ─── HireFlow: Phase 8 — Notifications ────────────────────────────────────────

model HfNotification {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  recipientId    String    @map("recipient_id")   // userId
  type           String    // INTERVIEW_SCHEDULED | FEEDBACK_REQUESTED | TASK_ASSIGNED | etc.
  channel        String    @default("in_app")     // in_app | email | sms
  title          String
  body           String
  metadata       Json      @default("{}")
  readAt         DateTime? @map("read_at")
  sentAt         DateTime? @map("sent_at")
  status         String    @default("pending")    // pending | sent | failed | read
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([organizationId, recipientId, status])
  @@index([recipientId, readAt])
  @@map("hf_notifications")
}

// ─── HireFlow: Phase 9 — Communication Engine ─────────────────────────────────

model HfCommunication {
  id              String    @id @default(uuid())
  organizationId  String    @map("organization_id")
  applicationId   String    @map("application_id")
  candidateId     String    @map("candidate_id")
  direction       String    // outbound | inbound
  channel         String    // email | sms | whatsapp
  subject         String?
  body            String
  templateId      String?   @map("template_id")
  sentByUserId    String?   @map("sent_by_user_id")
  sentAt          DateTime? @map("sent_at")
  deliveryStatus  String    @default("pending") @map("delivery_status")
  externalId      String?   @map("external_id") // provider message ID
  createdAt       DateTime  @default(now()) @map("created_at")

  application HfApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([organizationId, candidateId])
  @@map("hf_communications")
}

// ─── HireFlow: Phase 11 — Audit Log ───────────────────────────────────────────

model HfAuditLog {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  actorUserId    String?  @map("actor_user_id")
  action         String   // APPLICATION_STAGE_CHANGED | INTERVIEW_RESCHEDULED | etc.
  resourceType   String   @map("resource_type") // job | application | candidate | interview | task
  resourceId     String   @map("resource_id")
  before         Json?
  after          Json?
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId, resourceType, resourceId])
  @@index([organizationId, actorUserId])
  @@index([organizationId, createdAt])
  @@map("hf_audit_logs")
}
